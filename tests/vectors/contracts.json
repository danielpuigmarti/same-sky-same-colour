{
 "about": "Every name, field and value of the shared contracts. site/js/contracts.js and pipeline/sx/contracts.py are both tested against this list, so they cannot drift apart.",
 "constants": {
  "BUCKET_HOSTS": ["nasa-irsa-spherex.s3.us-east-1.amazonaws.com", "s3.us-east-1.amazonaws.com"],
  "BUCKET_URLS": ["https://nasa-irsa-spherex.s3.us-east-1.amazonaws.com/", "https://s3.us-east-1.amazonaws.com/nasa-irsa-spherex/"],
  "KEY_PATTERN": "dr1/level2/{week}/{ver}/{det}/level2_{week}_{obs:04d}_{exp}D{det}_spx_{ver}.fits",
  "KEY_REGEX": "^dr1\\/level2\\/([A-Za-z0-9_]+)\\/([A-Za-z0-9_.-]+)\\/([1-6])\\/level2_\\1_([0-9]{4})_([0-9])D\\3_spx_\\2\\.fits$",
  "INDEX_ROW": ["wv", "obs", "exp", "det", "t_mid_mjd", "ra1", "dec1", "ra2", "dec2", "ra3", "dec3", "ra4", "dec4"],
  "INDEX_DIR": "idx/",
  "INDEX_META_FILE": "meta.json",
  "INDEX_TILE_FILE": "t/{tile}.json.gz",
  "WAVE_TABLES_FILE": "data/wave/tables.json",
  "VISIT_GAP_DAYS": 10,
  "VISIT_RUN_DAYS": 60,
  "VISIT_BIN_DAYS": 30,
  "VISIT_MIN_FRAMES": 3,
  "MATCH_BANDWIDTH_FRACTION": 0.5,
  "MATCH_MAX_PAIRS": 8,
  "CLIP_SIGMA": 3,
  "CLIP_PASSES": 5,
  "MAD_TO_SIGMA": 1.4826,
  "DIFF_RANGE": 5,
  "MANIFEST_FILE": "manifest.json",
  "STAMPS_FILE": "stamps.bin",
  "FLAGS_FILE": "flags.bin",
  "CHECK_STATUSES": ["PASS", "FAIL", "LIMIT", "CORRECTED", "UNVERIFIED"],
  "CHECKS_FILE": "data/checks/checks.json",
  "CHECKS_PARTS_DIR": "data/checks/rows/",
  "NUMBERS_FILE": "data/numbers.json",
  "NUMBERS_PARTS_DIR": "data/numbers/",
  "VIEW_PAGE": "view.html",
  "VIEW_PARAMS": ["ra", "dec", "det", "mode", "a", "b", "fov", "t", "embed", "pitch", "q"],
  "VIEW_MODES": ["blink", "diff", "curtain", "side", "flip"],
  "FAILURE_STATES": ["no-coverage", "one-visit", "not-indexed", "slow", "unreachable", "too-bright", "too-faint", "quiet", "cancelled"]
 },
 "records": {
  "Frame": ["key", "det", "tmid", "corners"],
  "IndexMeta": ["T", "nbands", "nra", "wv", "complete", "key", "row", "n_frames"],
  "WaveTable": ["X", "Y", "lam", "bw", "src"],
  "Wavelength": ["lam", "bw"],
  "Stamp": ["key", "det", "mjd", "w", "h", "x0", "y0", "tx", "ty", "lam", "bw", "data", "flags", "sky"],
  "LocalSky": ["ra", "dec", "cd"],
  "Visit": ["frames", "short"],
  "Matchable": ["det", "lam", "bw"],
  "ShowcaseFrame": ["key", "mjd", "lam", "bw", "x0", "y0", "tx", "ty", "visit", "sky"],
  "Manifest": ["id", "name", "ra", "dec", "det", "w", "h", "frames", "pairs", "stamps", "flags", "refs", "numbers", "grid"],
  "CheckRow": ["id", "title", "claim", "test", "pass_rule", "rule_commit", "status", "plain", "value", "unit", "reference", "tolerance", "image", "image_sha256", "reviewer_role", "reviewed_on", "rerun"],
  "NumberEntry": ["value", "err", "unit", "text", "check"],
  "ViewAddress": ["ra", "dec", "det", "mode", "a", "b", "fov", "t", "embed", "pitch", "q"],
  "Failure": ["state"],
  "Plan": ["visits", "pairs", "bytes", "seconds"],
  "Client": ["plan", "load"]
 },
 "optional": {
  "Stamp": ["sky"],
  "ShowcaseFrame": ["sky"],
  "Manifest": ["grid"]
 },
 "others": ["Det", "RaDec", "IndexRow", "FramesCovering", "IsIndexed", "WaveTables", "WavelengthAt", "Visits", "Pair", "MatchPairs", "CheckStatus", "Numbers", "ViewMode", "FailureState", "OnProgress"]
}
