{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "checks.json (CT-9)",
 "description": "A list of rows, one per check.",
 "type": "array",
 "items": { "$ref": "#/$defs/row" },
 "$defs": {
  "row": {
   "type": "object",
   "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "description": "Unique name of the check." },
    "title": { "type": "string", "minLength": 1 },
    "claim": { "type": "string", "minLength": 1, "description": "What is claimed." },
    "test": { "type": "string", "minLength": 1, "description": "How it was tested." },
    "pass_rule": { "type": "string", "minLength": 1, "description": "The rule that decides the status, written before the test was run." },
    "rule_commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$", "description": "Commit in which the rule was written." },
    "status": { "enum": ["PASS", "FAIL", "LIMIT", "CORRECTED", "UNVERIFIED"] },
    "plain": { "type": "string", "minLength": 1, "description": "The plain-word tag shown in the story." },
    "value": { "type": ["number", "string", "null"], "description": "What was measured." },
    "unit": { "type": ["string", "null"] },
    "reference": { "type": ["number", "string", "null"], "description": "What it is compared with." },
    "tolerance": { "type": ["number", "string", "null"], "description": "How far value may be from reference." },
    "image": { "type": ["string", "null"], "minLength": 1, "description": "Picture of the check, a path inside data/checks/." },
    "image_sha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
    "reviewer_role": { "type": ["string", "null"], "minLength": 1, "description": "Role of the person who reviewed the check. A PASS row needs one." },
    "reviewed_on": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$", "description": "Date of the review. A PASS row needs one." },
    "rerun": { "type": ["string", "null"], "minLength": 1, "description": "Command that runs the check again." }
   },
   "required": ["id", "title", "claim", "test", "pass_rule", "rule_commit", "status", "plain", "value", "unit", "reference", "tolerance", "image", "image_sha256", "reviewer_role", "reviewed_on", "rerun"],
   "additionalProperties": false
  }
 }
}
