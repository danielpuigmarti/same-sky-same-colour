{
 "about": "Cases for the checks of the three JSON contracts. Each case starts from a fixture file, applies the steps in ops ([\"set\", path, value] or [\"del\", path]; a path is a list of keys and positions, and an empty path is the whole document) and says whether the result is valid. The JavaScript and the Python checks must both agree with every case.",
 "bases": {
  "numbers": "fixtures/contracts/numbers.json",
  "checks": "fixtures/contracts/checks.json",
  "manifest": "fixtures/showcase/barnard-d5/manifest.json"
 },
 "cases": [
  { "kind": "numbers", "name": "the fixture as it is", "ops": [], "valid": true },
  { "kind": "numbers", "name": "an uncertainty and no unit", "ops": [["set", ["fixture.stamps.frames", "err"], 0.5], ["set", ["fixture.stamps.frames", "unit"], null]], "valid": true },
  { "kind": "numbers", "name": "no numbers at all", "ops": [["set", [], {}]], "valid": true },
  { "kind": "numbers", "name": "text is missing", "ops": [["del", ["fixture.stamps.frames", "text"]]], "valid": false },
  { "kind": "numbers", "name": "text is empty", "ops": [["set", ["fixture.stamps.frames", "text"], ""]], "valid": false },
  { "kind": "numbers", "name": "value is a string", "ops": [["set", ["fixture.stamps.frames", "value"], "3"]], "valid": false },
  { "kind": "numbers", "name": "value is true", "ops": [["set", ["fixture.stamps.frames", "value"], true]], "valid": false },
  { "kind": "numbers", "name": "value is null", "ops": [["set", ["fixture.stamps.frames", "value"], null]], "valid": false },
  { "kind": "numbers", "name": "err is a string", "ops": [["set", ["fixture.stamps.frames", "err"], "0.5"]], "valid": false },
  { "kind": "numbers", "name": "a field that is not in the contract", "ops": [["set", ["fixture.stamps.frames", "note"], "x"]], "valid": false },
  { "kind": "numbers", "name": "a key with a space", "ops": [["set", ["bad key"], { "value": 1, "err": null, "unit": null, "text": "1", "check": null }]], "valid": false },
  { "kind": "numbers", "name": "an entry that is a bare number", "ops": [["set", ["fixture.bare"], 3]], "valid": false },
  { "kind": "numbers", "name": "a list in place of the object", "ops": [["set", [], []]], "valid": false },

  { "kind": "checks", "name": "the fixture as it is", "ops": [], "valid": true },
  { "kind": "checks", "name": "no rows", "ops": [["set", [], []]], "valid": true },
  { "kind": "checks", "name": "PASS with a reviewer and a date", "ops": [["set", [0, "status"], "PASS"], ["set", [0, "reviewer_role"], "physicist"], ["set", [0, "reviewed_on"], "2026-11-15"]], "valid": true },
  { "kind": "checks", "name": "PASS without a reviewer", "ops": [["set", [0, "status"], "PASS"], ["set", [0, "reviewed_on"], "2026-11-15"]], "valid": false },
  { "kind": "checks", "name": "PASS without a date", "ops": [["set", [0, "status"], "PASS"], ["set", [0, "reviewer_role"], "physicist"]], "valid": false },
  { "kind": "checks", "name": "FAIL needs no reviewer", "ops": [["set", [0, "status"], "FAIL"]], "valid": true },
  { "kind": "checks", "name": "a status that does not exist", "ops": [["set", [0, "status"], "OK"]], "valid": false },
  { "kind": "checks", "name": "status in lower case", "ops": [["set", [0, "status"], "pass"]], "valid": false },
  { "kind": "checks", "name": "the same id twice", "ops": [["set", [1, "id"], "fixture-stamps"]], "valid": false },
  { "kind": "checks", "name": "a field is missing", "ops": [["del", [2, "rerun"]]], "valid": false },
  { "kind": "checks", "name": "a field that is not in the contract", "ops": [["set", [2, "notes"], "x"]], "valid": false },
  { "kind": "checks", "name": "a date that is not a date", "ops": [["set", [0, "reviewed_on"], "15 November"]], "valid": false },
  { "kind": "checks", "name": "a picture without its hash", "ops": [["set", [0, "image"], "img/fixture-stamps.png"]], "valid": false },
  { "kind": "checks", "name": "a picture with its hash", "ops": [["set", [0, "image"], "img/fixture-stamps.png"], ["set", [0, "image_sha256"], "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"]], "valid": true },
  { "kind": "checks", "name": "a hash that is too short", "ops": [["set", [0, "image"], "img/fixture-stamps.png"], ["set", [0, "image_sha256"], "e3b0c442"]], "valid": false },
  { "kind": "checks", "name": "a commit that is not a hash", "ops": [["set", [0, "rule_commit"], "HEAD"]], "valid": false },
  { "kind": "checks", "name": "a commit hash", "ops": [["set", [0, "rule_commit"], "0123abc"]], "valid": true },
  { "kind": "checks", "name": "an object in place of the list", "ops": [["set", [], {}]], "valid": false },

  { "kind": "manifest", "name": "the fixture as it is", "ops": [], "valid": true },
  { "kind": "manifest", "name": "no flags file", "ops": [["set", ["flags"], null]], "valid": true },
  { "kind": "manifest", "name": "no pairs", "ops": [["set", ["pairs"], []]], "valid": true },
  { "kind": "manifest", "name": "the display grid", "ops": [["set", ["grid"], "north-up"]], "valid": true },
  { "kind": "manifest", "name": "the detector grid, said aloud", "ops": [["set", ["grid"], "detector"]], "valid": true },
  { "kind": "manifest", "name": "a grid that does not exist", "ops": [["set", ["grid"], "south-up"]], "valid": false },
  { "kind": "manifest", "name": "a frame with its sky", "ops": [["set", ["frames", 0, "sky"], {"ra": 269.4, "dec": 4.7, "cd": [-0.0017, 0, 0, 0.0017]}]], "valid": true },
  { "kind": "manifest", "name": "a sky with three numbers in cd", "ops": [["set", ["frames", 0, "sky"], {"ra": 269.4, "dec": 4.7, "cd": [-0.0017, 0, 0.0017]}]], "valid": false },
  { "kind": "manifest", "name": "a sky without dec", "ops": [["set", ["frames", 0, "sky"], {"ra": 269.4, "cd": [-0.0017, 0, 0, 0.0017]}]], "valid": false },
  { "kind": "manifest", "name": "a sky with a field that is not known", "ops": [["set", ["frames", 0, "sky"], {"ra": 269.4, "dec": 4.7, "cd": [-0.0017, 0, 0, 0.0017], "roll": 3}]], "valid": false },
  { "kind": "manifest", "name": "another name for the stamps file", "ops": [["set", ["stamps"], "data.bin"]], "valid": false },
  { "kind": "manifest", "name": "detector 7", "ops": [["set", ["det"], 7]], "valid": false },
  { "kind": "manifest", "name": "ra of 360", "ops": [["set", ["ra"], 360]], "valid": false },
  { "kind": "manifest", "name": "a width that is not whole", "ops": [["set", ["w"], 64.5]], "valid": false },
  { "kind": "manifest", "name": "refs is missing", "ops": [["del", ["refs"]]], "valid": false },
  { "kind": "manifest", "name": "a frame without its wavelength", "ops": [["del", ["frames", 0, "lam"]]], "valid": false },
  { "kind": "manifest", "name": "a frame with a field that is not in the contract", "ops": [["set", ["frames", 0, "url"], "x"]], "valid": false },
  { "kind": "manifest", "name": "a key that is not a bucket key", "ops": [["set", ["frames", 0, "key"], "level2.fits"]], "valid": false },
  { "kind": "manifest", "name": "a pair that names a frame that is not there", "ops": [["set", ["pairs"], [[0, 9]]]], "valid": false },
  { "kind": "manifest", "name": "a pair inside one visit", "ops": [["set", ["pairs"], [[0, 1]]]], "valid": false },
  { "kind": "manifest", "name": "a pair with the later visit first", "ops": [["set", ["pairs"], [[2, 0]]]], "valid": false },
  { "kind": "manifest", "name": "a frame in two pairs", "ops": [["set", ["pairs"], [[0, 2], [0, 3]]]], "valid": false },
  { "kind": "manifest", "name": "a pair of three", "ops": [["set", ["pairs"], [[0, 2, 3]]]], "valid": false },
  { "kind": "manifest", "name": "frames out of time order", "ops": [["set", ["frames", 0, "mjd"], 70000]], "valid": false },
  { "kind": "manifest", "name": "a visit number that skips", "ops": [["set", ["frames", 2, "visit"], 2], ["set", ["frames", 3, "visit"], 2]], "valid": false },
  { "kind": "manifest", "name": "the first visit is not 0", "ops": [["set", ["frames", 0, "visit"], 1], ["set", ["frames", 1, "visit"], 1], ["set", ["pairs"], []]], "valid": false },
  { "kind": "manifest", "name": "numbers holds a key", "ops": [["set", ["numbers"], ["fixture.stamps.frames"]]], "valid": true },
  { "kind": "manifest", "name": "numbers holds a number", "ops": [["set", ["numbers"], [3]]], "valid": false }
 ]
}
